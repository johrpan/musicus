using Gtk 4.0;
using Adw 1;

template $MusicusEditorTagRow: Adw.ActionRow {
  [prefix]
  Gtk.Image {
    icon-name: "list-drag-handle-symbolic";

    styles [
      "drag-handle",
    ]
  }

  Gtk.MenuButton value_button {
    visible: false;
    valign: center;
    label: _("Value");

    popover: Gtk.Popover value_popover {
      closed => $value_popover_closed() swapped;

      $MusicusTranslationEditor value_editor {}
    };
  }

  Gtk.Button {
    icon-name: "user-trash-symbolic";
    valign: center;
    clicked => $remove() swapped;

    styles [
      "flat",
    ]
  }
}
